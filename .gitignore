# Dependencies
node_modules/

# Generated STLs. Every file is reproduced byte-for-byte by `node 8-build-stl.js`,
# and a rebuild replaces all 45 of them at once, so keeping them here would add
# ~47 MB to history on every iteration. `build/` is kept deliberately: it is only
# ~1.4 MB and the READMEs cite those images as evidence.
dragons-logo/stl/

# OS and editor cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
